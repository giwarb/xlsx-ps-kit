+# --- メイン ---
+
+function Get-XlsFixtureExcelPids {
+    [CmdletBinding()]
+    param()
+    return , @(Get-Process -Name EXCEL -ErrorAction SilentlyContinue | ForEach-Object { $_.Id })
+}
+
+$baselinePids = Get-XlsFixtureExcelPids
+
