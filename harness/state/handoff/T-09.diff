+        It 'converts 1900-01-01 back to serial 1 (the +1 correction boundary)' {
+            (& $script:ModuleRef { ConvertFrom-XlsIsoDateStringToSerial -Text '1900-01-01' }) | Should Be 1.0
+        }
+
